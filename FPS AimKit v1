function GetAimPart(character, aimPartName)
    if not character then return nil end

    local part = character:FindFirstChild(aimPartName)
    if part then return part end

    if aimPartName == "Torso" then
        return character:FindFirstChild("UpperTorso") 
            or character:FindFirstChild("Torso")
    end

    if aimPartName == "Root" or aimPartName == "HumanoidRootPart" then
        return character:FindFirstChild("HumanoidRootPart")
    end

    if aimPartName == "Left Arm" then
        return character:FindFirstChild("LeftUpperArm") 
            or character:FindFirstChild("Left Arm")
    end

    if aimPartName == "Right Arm" then
        return character:FindFirstChild("RightUpperArm") 
            or character:FindFirstChild("Right Arm")
    end

    if aimPartName == "Left Leg" then
        return character:FindFirstChild("LeftUpperLeg") 
            or character:FindFirstChild("Left Leg")
    end

    if aimPartName == "Right Leg" then
        return character:FindFirstChild("RightUpperLeg") 
            or character:FindFirstChild("Right Leg")
    end

    return nil
end


local function checkTeam(player)
    if not teamCheck then return false end

    -- 1️⃣ Team Service
    if player.Team and plr.Team and player.Team == plr.Team then
        return true
    end

    -- 2️⃣ TeamColor
    if player.TeamColor and plr.TeamColor and player.TeamColor == plr.TeamColor then
        return true
    end

    -- 3️⃣ Attribute Team
    local myAttr = plr:GetAttribute("Team") or plr:GetAttribute("Faction") or plr:GetAttribute("Side")
    local targetAttr = player:GetAttribute("Team") or player:GetAttribute("Faction") or player:GetAttribute("Side")

    if myAttr and targetAttr and myAttr == targetAttr then
        return true
    end

    -- 4️⃣ Value trong Player
    local myValue = plr:FindFirstChild("Team")
    local targetValue = player:FindFirstChild("Team")

    if myValue and targetValue and myValue.Value == targetValue.Value then
        return true
    end

    -- 5️⃣ Value trong Character
    if player.Character and plr.Character then
        local myCharValue = plr.Character:FindFirstChild("Team")
        local targetCharValue = player.Character:FindFirstChild("Team")

        if myCharValue and targetCharValue and myCharValue.Value == targetCharValue.Value then
            return true
        end
    end

    return false
end


local function checkWall(targetCharacter)
    local targetHead = targetCharacter:FindFirstChild("Head")
    if not targetHead then return true end

    local origin = camera.CFrame.Position
    local direction = (targetHead.Position - origin).unit * (targetHead.Position - origin).magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {plr.Character, targetCharacter}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

    local raycastResult = wrk:Raycast(origin, direction, raycastParams)
    return raycastResult and raycastResult.Instance ~= nil
end

local function getClosestPart(character)
    local closestPart = nil
    local shortestCursorDistance = aimFov * 0.8

    -- nếu bạn chỉ muốn 1 part theo dropdown
    local part = GetAimPart(character, selectedAimPart)

    if part then
        local partPos, onScreen = camera:WorldToViewportPoint(part.Position)
        if onScreen then
            local screenPos = Vector2.new(partPos.X, partPos.Y)
            local cursorDistance = (screenPos - Vector2.new(mouse.X, mouse.Y)).Magnitude

            if cursorDistance < shortestCursorDistance then
                closestPart = part
            end
        end
    end

    return closestPart
end




local function getTarget()
    local nearestPlayer = nil
    local closestPart = nil
    local shortestDistance = aimMaxDistance -- khoảng cách nhỏ nhất

    for _, player in ipairs(players:GetPlayers()) do
        if player ~= plr and player.Character and not checkTeam(player) then
            
            local hum = player.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then

                local targetPart = getClosestPart(player.Character)
                if targetPart then

                    -- 🔥 TÍNH KHOẢNG CÁCH 3D
                    local distance = (targetPart.Position - camera.CFrame.Position).Magnitude
                    
                    -- 🔥 ƯU TIÊN NGƯỜI GẦN NHẤT
                    if distance < shortestDistance then
                        
                        -- check FOV
                        local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local cursorDistance = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                            
                            if cursorDistance <= aimFov then
                                if not wallCheck or not checkWall(player.Character) then
                                    shortestDistance = distance
                                    nearestPlayer = player
                                    closestPart = targetPart
                                end
                            end
                        end
                    end

                end
            end
        end
    end

    return nearestPlayer, closestPart
end


local function predict(player, part)
    if player and part then
        local velocity = player.Character.HumanoidRootPart.Velocity
        local predictedPosition = part.Position + (velocity * predictionStrength) * 0.5 -- Giảm sức mạnh dự đoán
        return predictedPosition
    end
    return nil
end

local function smooth(from, to)
    return from:Lerp(to, smoothing * 0.8) -- Tăng độ bám sát mục tiêu
end

local function aimAt(player, part)
    if not player or not part then return end

    local character = player.Character
    if not character then return end

    local hum = character:FindFirstChild("Humanoid")
    if not hum then return end


    local predictedPosition = predict(player, part)
    if predictedPosition then
        camera.CFrame = CFrame.new(camera.CFrame.Position, predictedPosition)
    end
end



