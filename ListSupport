-- 🔹 progress bar function
local function progressBar(text, duration)
    local steps = 20 -- độ dài thanh
    local waitTime = duration / steps

    for i = 1, steps do
        local percent = math.floor((i / steps) * 100)
        local filled = string.rep("#", i)
        local empty = string.rep("-", steps - i)

        print(text .. " [" .. filled .. empty .. "] " .. percent .. "%")
        task.wait(waitTime)
    end
end

